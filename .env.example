# Copy this file to .env.local and fill in the values. Never commit .env.local.

# SQLite database file, created on first run
DATABASE_URI=file:./payload.db

# Long random string. Signs sessions and encrypts stored AI keys.
PAYLOAD_SECRET=change-me-to-a-long-random-string

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PayPal sandbox app (Business account). Turn on Transaction Search and Invoicing.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional: a server-wide OpenAI key. Users can also connect their own on the AI Insights page.
# APP_OPENAI_API_KEY=
# APP_OPENAI_MODEL=gpt-4o-mini

# Optional: lets users sign in with Google to use Gemini.
# Authorised redirect URI: http://localhost:3000/ai/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
